---
import Editorial from '../layouts/Editorial.astro';
import { getCollection } from 'astro:content';
import { jekyllPath, formatDate } from '../lib/dates';
import { getWordCount, getReadingTime, formatReadingTime } from '../lib/reading-time';

const posts = await getCollection('writing', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const selectedPosts = posts.filter(p => p.data.selected);
const featuredPosts = (selectedPosts.length >= 4 ? selectedPosts : posts)
  .slice(0, 4)
  .map(post => {
    const wordCount = getWordCount(post.body ?? '');
    return { post, wordCount, readingTime: getReadingTime(wordCount) };
  });

const projects = await getCollection('work');
projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const library = await getCollection('library');
const nowReading = library.filter(i => i.data.status === 'now' || i.data.status === 'ongoing');
---

<Editorial title="Benjamin Schneider" description="Personal website of Benjamin Schneider — writing, reading, and work.">
  <div slot="header" class="site-header">
    <p class="bio">
      Swiss guy with a background in computer science and economics.
      Currently working as a solution architect at vivenu, a ticket sales software company, in Zurich.
    </p>
    <p class="bio bio-secondary">
      I like cooking curry from scratch,
      adding new layers to my mental map of the world,
      and walking in nature taking pictures of the same views over and over again.
    </p>
    <nav class="contact-links">
      <a href="mailto:mail@benjaminschneider.ch">mail</a>
      <a href="https://twitter.com/bschne">twitter</a>
      <a href="https://bsky.app/profile/benjaminschneider.ch">bluesky</a>
      <a href="https://instagram.com/benjaminschneider">instagram</a>
      <a href="https://linkedin.com/in/schneiderbenjamin">linkedin</a>
    </nav>
  </div>

  <div slot="main">
    <section class="home-section">
      <h2>Selected Writing</h2>
      <ul class="writing-list">
        {featuredPosts.map(({ post, wordCount, readingTime }) => (
          <li>
            <div class="item-line">
              <a href={jekyllPath(post.data.date, post.id)}>{post.data.title}</a>
              <span class="item-meta">{`· ${wordCount.toLocaleString()} words · ${formatReadingTime(readingTime)}`}</span>
            </div>
            {post.data.description && (
              <div class="item-desc">{post.data.description}</div>
            )}
          </li>
        ))}
      </ul>
      <a href="/writing" class="more-link">all writing →</a>
    </section>

    <section class="home-section">
      <h2>Work</h2>
      <ul class="writing-list">
        {projects.slice(0, 4).map(project => (
          <li>
            {project.data.url ? (
              <a href={project.data.url}>{project.data.title}</a>
            ) : (
              <span class="item-title">{project.data.title}</span>
            )}
            <div class="item-desc">{project.data.summary}</div>
          </li>
        ))}
      </ul>
      <!-- <a href="/work" class="more-link">all →</a> -->
    </section>
  </div>

  <div slot="rail">
    <section class="rail-section">
      <h3>Now</h3>
      <p class="rail-text">
        Settling into my new role at vivenu, trying to write more and meet interesting people.
      </p>
      <a href="/now" class="rail-link">more →</a>
    </section>

    <section class="rail-section">
      <h3>Reading</h3>
      {nowReading.length > 0 && (
        <ul class="reading-list">
          {nowReading.map(item => (
            <li>
              <span class="reading-title">{item.data.title}</span>
              <span class="reading-creator"> · {item.data.creator.split(';')[0]}</span>
            </li>
          ))}
        </ul>
      )}
      <p class="rail-text">A list of books, papers, and other pieces I enjoyed with occasional reading notes.</p>
      <a href="/library" class="rail-link">library →</a>
    </section>

  </div>
</Editorial>

<style>
  /* Two sizes only, borrowed from the library rows: things at the base
     size, notes about them a step down. Weight is reserved for the
     section headers, so nothing inside a list competes with them. */
  .site-header,
  .home-section,
  .rail-section {
    font-size: var(--text-body);
  }

  /* ── Header ──────────────────────────────────────────────────────
     The lead bio sits at full contrast, the personal aside a step
     back, so the eye lands on the first line. */
  .bio {
    font-weight: var(--weight-normal);
    color: var(--color-text-primary);
    max-width: 52ch;
    margin-bottom: 0.875rem;
    line-height: 1.65;
  }

  .bio-secondary {
    color: var(--color-text-secondary);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    font-size: var(--text-meta);
    color: var(--color-text-tertiary);
  }

  .contact-links a {
    text-decoration: none;
  }

  .contact-links a:hover {
    color: var(--color-accent);
  }

  /* ── Section headers ─────────────────────────────────────────────
     The only bold, full-black text on the page. */
  .home-section {
    margin-bottom: var(--space-2-5);
  }

  .home-section h2,
  .rail-section h3 {
    font-size: inherit;
    font-weight: var(--weight-semibold);
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  /* ── Main column ─────────────────────────────────────────────────
     Titles black at the base size, descriptions grey and smaller —
     the separation is size and colour, never weight. */
  .writing-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .writing-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .writing-list a,
  .item-title {
    font-weight: var(--weight-normal);
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .writing-list a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: transparent;
  }

  .writing-list a:hover {
    text-decoration-color: var(--color-accent);
    color: var(--color-accent);
  }

  .item-desc {
    font-size: var(--text-meta);
    font-weight: var(--weight-normal);
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  /* trails the title on the same line; wraps as one unit if it runs out of room */
  .item-line {
    line-height: 1.4;
  }

  .item-meta {
    font-size: var(--text-label);
    color: var(--color-text-tertiary);
    margin-left: 0.25rem;
    white-space: nowrap;
  }

  .more-link,
  .rail-link {
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .more-link:hover,
  .rail-link:hover {
    color: var(--color-accent);
  }

  /* ── Rail ────────────────────────────────────────────────────────
     Same two tiers, a shade quieter. */
  .rail-section {
    margin-bottom: var(--space-2);
  }

  .rail-text {
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 0.5rem;
  }

  .reading-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .reading-title {
    font-weight: var(--weight-normal);
    color: var(--color-text-primary);
  }

  .reading-list a {
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .reading-list a:hover {
    color: var(--color-accent);
  }

  .reading-creator {
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
  }
</style>
