---
import Base from '../../layouts/Base.astro';
import LibraryList from '../../components/LibraryList.astro';
import { FILTER_ROUTES } from '../../lib/library';

export async function getStaticPaths() {
  return Object.keys(FILTER_ROUTES).map(type => ({ params: { type } }));
}

const { type } = Astro.params as { type: string };
---

<Base title={`Library — ${type}`}>
  <LibraryList filter={FILTER_ROUTES[type]} />
</Base>
