---
/* `build.format: 'file'` makes Astro.url.pathname the *output file* path, so
   at build time the home page is '/index.html' and never '/' — the dev server
   serves it as '/'. Accept both, or the header dims on every page. */
const path = Astro.url.pathname;
const isHome = path === '/' || path === '/index.html';
---

<nav class:list={['site-nav', !isHome && 'is-quiet']}>
  <div class="site-nav-left">
    <a href="/" class="site-nav-name">Benjamin Schneider</a>
    <div class="site-nav-links">
      <a href="/writing">writing</a>
      <a href="/library">library</a>
      <a href="/now">now</a>
      <a href="/about">about</a>
    </div>
  </div>

  {/* Hidden until the script below claims it: without JS the button could not
      switch anything, and the system setting is already doing the right thing. */}
  <button type="button" class="theme-toggle" hidden aria-label="Switch theme">
    <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.5 13.2A8.2 8.2 0 0 1 10.8 3.5a8.5 8.5 0 1 0 9.7 9.7z" />
    </svg>
    <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.6v2.2M12 19.2v2.2M4.35 4.35l1.56 1.56M18.09 18.09l1.56 1.56M2.6 12h2.2M19.2 12h2.2M4.35 19.65l1.56-1.56M18.09 5.91l1.56-1.56" />
    </svg>
  </button>
</nav>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    var system = matchMedia('(prefers-color-scheme: dark)');

    /* The pinned theme if there is one, otherwise whatever the system says. */
    function current() {
      return root.dataset.theme || (system.matches ? 'dark' : 'light');
    }

    function label() {
      btn.setAttribute(
        'aria-label',
        current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
      );
    }

    btn.hidden = false;
    label();
    system.addEventListener('change', label);

    btn.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      label();
    });
  })();
</script>


<style>
  .site-nav {
    /* Every colour in the bar hangs off these three, so the quiet state
       below is a re-pointing of them and nothing else. */
    --nav-name: var(--color-text-primary);
    --nav-link: var(--color-text-secondary);
    --nav-icon: var(--color-text-tertiary);

    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.875rem var(--content-padding) 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
  }


  /* Off the home page the header is a way back, not the page's own title:
     drop all three a step or two down the grey ramp until the reader reaches
     for it, at which point the bar comes back to full strength as a unit. */
  .site-nav.is-quiet {
    --nav-name: var(--color-text-tertiary);
    --nav-link: var(--color-text-quaternary);
    --nav-icon: var(--color-text-quaternary);
  }

  .site-nav.is-quiet:hover,
  .site-nav.is-quiet:focus-within {
    --nav-name: var(--color-text-primary);
    --nav-link: var(--color-text-secondary);
    --nav-icon: var(--color-text-tertiary);
  }

  /* Nothing on a touch device ever hovers, so there the bar would simply stay
     dimmed with no way back: leave it at full strength. */
  @media (hover: none) {
    .site-nav.is-quiet {
      --nav-name: var(--color-text-primary);
      --nav-link: var(--color-text-secondary);
      --nav-icon: var(--color-text-tertiary);
    }
  }

  .site-nav-left {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .site-nav-name {
    font-size: var(--text-h2);
    font-weight: 500;
    text-decoration: none;
    color: var(--nav-name);
    transition: color 0.15s ease;
  }

  .site-nav-name:hover {
    color: var(--color-accent);
  }

  .site-nav-links {
    display: flex;
    gap: 1rem;
    font-size: var(--text-meta);
  }

  .site-nav-links a {
    text-decoration: none;
    color: var(--nav-link);
    transition: color 0.15s ease;
  }

  .site-nav-links a:hover {
    color: var(--color-accent);
  }

  /* Sits opposite the name, on the nav's own baseline-ish centre line. The
     icon is one tier quieter than the links until you reach for it. */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: -0.375rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--nav-icon);
    transition: color 0.15s ease;
    cursor: pointer;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  .icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* which of the two shows is a theme token, set in tokens.css */
  .icon-moon {
    display: var(--icon-moon);
  }

  .icon-sun {
    display: var(--icon-sun);
  }

  /* Narrow enough that name and links can no longer share a line: rather than
     let the name wrap mid-word, give each its own row and keep the toggle in
     the top-right corner, level with the first line of the name. */
  @media (max-width: 32.5rem) {
    .site-nav {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      row-gap: 0.375rem;
    }

    .site-nav-left {
      display: contents;
    }

    .site-nav-name {
      grid-column: 1;
      grid-row: 1;
    }

    .site-nav-links {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .theme-toggle {
      grid-column: 2;
      grid-row: 1;
      /* centre the icon on the name's cap height rather than on the row */
      margin-top: -0.125rem;
    }
  }
</style>
