---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { formatDateShort } from '../lib/dates';
import { creatorShort } from '../lib/creators';

interface Props {
  item: CollectionEntry<'library'>;
  hasNote: boolean;
  /* filtered out by the server render; the filter script toggles it after */
  hidden?: boolean;
}

const { item, hasNote, hidden = false } = Astro.props;
const { type, title, creator, status, starred, nope, date, url, blurb, inline, genre, topics } = item.data;
const slug = item.id.replace(/\.mdx?$/, '');
const sourceHostname = url ? new URL(url).hostname.replace(/^www\./, '') : null;
const noteHref = hasNote ? `/library/${slug}` : null;
const dateLabel = status === 'ongoing' ? 'ongoing' : date ? formatDateShort(date) : '';

const { Content } = inline && item.body ? await render(item) : { Content: null };
---

<li
  class:list={['row', { 'is-nope': nope }]}
  id={slug}
  hidden={hidden}
  data-lib-row
  data-type={type}
  data-genre={genre}
  data-topics={topics.join(' ')}
  data-starred={String(starred)}
  data-nope={String(nope)}
>
  <span class="row-type">{type === 'podcast' ? 'pod' : type}</span>
  <div class="row-body">
    <div class="row-main">
      <span class="row-title">
        {title}{starred && <span class="row-star" aria-label="recommended">★</span>}{nope && (
          <span class="row-nope" aria-label="did not like it">✗</span>
        )}
        <span class="row-creator"> · {creatorShort(creator)}</span>
        <a href={`#${slug}`} class="row-anchor" aria-label={`Link to ${title}`}>#</a>
      </span>
      <span class="row-right">
        {sourceHostname && (
          <a href={url} class="row-source" target="_blank" rel="noopener">↗ {sourceHostname}</a>
        )}
        {dateLabel && <span class="row-date">{dateLabel}</span>}
      </span>
    </div>
    {blurb && <p class="row-inline-note row-blurb">{blurb}</p>}
    {Content && (
      <div class="row-inline-note">
        <Content />
      </div>
    )}
    {noteHref && (
      <a href={noteHref} class="row-note-link">my notes →</a>
    )}
  </div>
</li>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 0.5px solid var(--color-border);
    align-items: baseline;
    font-size: var(--text-meta);
    scroll-margin-top: 2rem;
  }

  /* the UA's [hidden] rule loses to the display above, so say it here */
  .row[hidden] {
    display: none;
  }

  /* the same accent bar the Now section wears, over a wash of the same colour;
     both drawn outside the box, so linking to a row marks it without nudging
     the list sideways */
  .row:target::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: -1rem;
    right: -0.5rem;
    top: 0;
    bottom: 0;
    border-left: 2px solid var(--color-accent);
    background: var(--color-accent-wash);
    border-radius: 0 2px 2px 0;
  }

  .row:has(.row-inline-note) {
    padding-bottom: 1rem;
  }

  .row-type {
    color: var(--color-text-tertiary);
  }

  .row-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .row-main {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .row-title {
    font-size: var(--text-body);
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  /* smaller than the title it sits in, so baseline alignment would drop it
     low; centre it on the title's x-height instead */
  /* present at all times so revealing it shifts nothing; the row has to be
     hovered, focused or linked to before it is worth reading */
  .row-anchor {
    margin-left: 0.4em;
    font-size: var(--text-label);
    color: var(--color-text-quaternary);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.12s ease;
  }
  .row:hover .row-anchor,
  .row:target .row-anchor,
  .row-anchor:focus-visible {
    opacity: 1;
  }
  .row-anchor:hover { color: var(--color-accent); }

  /* nothing to hover on a touch screen, so the marker just stays */
  @media (hover: none) {
    .row-anchor { opacity: 1; }
  }

  /* the two verdicts are one mark in two colours, so they sit identically on
     the line whichever one a row carries */
  .row-star,
  .row-nope {
    font-size: var(--text-label);
    display: inline-block;
    line-height: 1;
    vertical-align: middle;
    margin-left: 0.35em;
  }

  .row-star {
    color: var(--color-accent);
  }

  /* grey rather than accent: the row is being played down, not pointed at */
  .row-nope {
    color: var(--color-text-tertiary);
  }

  /* dimmed as a whole — title, creator, date and marker together — so the row
     reads as set aside rather than as a line with a grey word in it, and comes
     back up to full strength when it is actually being read */
  .row.is-nope {
    opacity: 0.45;
    transition: opacity 0.12s ease;
  }
  .row.is-nope:hover,
  .row.is-nope:focus-within,
  .row.is-nope:target {
    opacity: 1;
  }

  /* nothing to hover on a touch screen, and a row nobody can undim has to stay
     legible on its own, so there the marker carries it and the dimming is only
     a shade */
  @media (hover: none) {
    .row.is-nope { opacity: 0.7; }
  }

  @media (prefers-reduced-motion: reduce) {
    .row.is-nope { transition: none; }
  }

  .row-creator {
    color: var(--color-text-secondary);
  }

  .row-right {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-shrink: 0;
    font-size: var(--text-label);
    white-space: nowrap;
  }

  .row-date {
    color: var(--color-text-tertiary);
  }

  .row-source {
    color: var(--color-text-tertiary);
    text-decoration: none;
  }
  .row-source:hover { color: var(--color-accent); }

  .row-note-link {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--color-border);
  }
  .row-note-link:hover { color: var(--color-accent); }

  .row-inline-note {
    margin-top: 0.1rem;
    max-width: 72ch;
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .row-inline-note :global(p) {
    margin: 0 0 0.5em;
  }
  .row-inline-note :global(p:last-child) {
    margin-bottom: 0;
  }
  .row-inline-note :global(a) {
    color: var(--color-text-secondary);
    text-underline-offset: 0.15em;
  }
  .row-inline-note :global(a:hover) {
    color: var(--color-accent);
  }
</style>
