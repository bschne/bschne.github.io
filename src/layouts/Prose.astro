---
import Base from './Base.astro';
import TopicList from '../components/TopicList.astro';
import TableOfContents from '../components/TableOfContents.astro';
import '../styles/prose.css';
import { formatDate } from '../lib/dates';
import { formatReadingTime } from '../lib/reading-time';
import type { MarkdownHeading } from 'astro';
import type { OgImage } from '../lib/og-image';

interface Props {
  title: string;
  description?: string;
  image?: OgImage;
  type?: 'website' | 'article';
  date?: Date;
  topics?: string[];
  wordCount?: number;
  readingTime?: number;
  headings?: MarkdownHeading[];
}

const { title, description, image, type, date, topics = [], wordCount, readingTime, headings = [] } = Astro.props;
---

<Base title={title} description={description} image={image} type={type}>
  <div class="prose-page">
    <header class="prose-header">
      {date && (
        <div class="header-meta">
          <time class="post-date" datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
          {wordCount !== undefined && readingTime !== undefined && (
            <div class="reading-meta">
              <span class="meta-item">{wordCount.toLocaleString()} words</span>
              <span class="meta-separator">·</span>
              <span class="meta-item">{formatReadingTime(readingTime)}</span>
            </div>
          )}
        </div>
      )}
    </header>
    <TableOfContents headings={headings} />
    <main class="prose-wrap">
      <article>
        <h1>{title}</h1>
        <div class="prose">
          <slot />
        </div>
        {topics.length > 0 && (
          <footer class="post-footer">
            <TopicList topics={topics} />
          </footer>
        )}
      </article>
    </main>
  </div>
</Base>

<style>
  .prose-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2) var(--content-padding) var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .prose-header {
    align-self: stretch;
    border-top: 1px solid var(--color-accent);
    padding-top: var(--space-1);
    margin-bottom: var(--space-1-5);
  }

  /* the accent rule spans the full container, but the meta inside it lines
     up with the 680px prose column so it sits directly above the title */
  .header-meta {
    width: 100%;
    max-width: 680px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-date {
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
  }

  .reading-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
  }

  .meta-separator {
    color: var(--color-border);
  }

  .prose-wrap {
    width: 100%;
    max-width: 680px;
  }

  .prose-wrap h1 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    font-weight: 500;
    margin-bottom: var(--space-1-5);
  }

  .post-footer {
    margin-top: var(--space-2);
    padding-top: var(--space-1);
    border-top: 0.5px solid var(--color-border);
  }
</style>
